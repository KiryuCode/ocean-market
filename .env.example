# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# 0.0.0.0 = accept remote connections; 127.0.0.1 = local only (use with nginx)
HOST=0.0.0.0
# Docker Compose publish bind. Production behind nginx must be 127.0.0.1.
# Local `docker compose up` can leave this unset (defaults to 0.0.0.0).
HOST_BIND=127.0.0.1
# Strong random string for session cookies (required in production)
SESSION_SECRET=replace-with-a-long-random-secret

# Admin login (session cookie — password is never in the URL)
# Set a strong password, or store only a bcrypt hash (preferred in production).
# Generate a hash: npm run admin:hash -- 'your-password'
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=

# Set when reverse-proxied (nginx/Caddy) so client IP + HTTPS work correctly
TRUST_PROXY=true
# Set when the site is served over HTTPS so session cookies are Secure.
# Session cookie is httpOnly and SameSite=Lax. The id is stored server-side.
COOKIE_SECURE=true

# Abuse throttles. 0 disables that one counter. Windows are seconds.
# Defaults: 5 orders/IP/hour, 3 orders/email/hour, same numbers for order mail.
# ORDER_RATE_LIMIT_IP=5
# ORDER_RATE_LIMIT_EMAIL=3
# ORDER_RATE_WINDOW_SEC=3600
# MAIL_RATE_LIMIT_IP=5
# MAIL_RATE_LIMIT_EMAIL=3
# MAIL_RATE_WINDOW_SEC=3600
# Checkout forms expire after this many seconds (default 7200).
# CHECKOUT_TOKEN_TTL_SEC=7200
# Failed checkout attempts stored per IP and per email in the window (default 8).
# 0 stores none. Successful orders are counted separately.
# ORDER_FAIL_LIMIT=8
# How long abuse rows and spent checkout tokens are kept (default 86400).
# ABUSE_RETENTION_SEC=86400
# Unused confirm forms kept per session (default 3). Older ones are deleted.
# CHECKOUT_UNUSED_TOKEN_CAP=3
# Order mail is queued and retried. Defaults: 5 attempts, 30s base backoff.
# MAIL_MAX_ATTEMPTS=5
# MAIL_RETRY_BASE_MS=30000
# MAIL_RETRY_MAX_MS=900000
# MAIL_SEND_LEASE_MS=120000
# SMTP attempt is capped below half the lease so a live send is not stolen.
# MAIL_SMTP_TIMEOUT_MS=60000
# After a timeout the row stays delivery-unknown until this grace (default: the
# lease) plus 5s. A late success is recorded and is not retried.
# MAIL_UNKNOWN_GRACE_MS=120000
# Retries of a checkout transaction after InnoDB deadlock or lock wait.
# CHECKOUT_LOCK_RETRIES=5
# MAIL_RETRY_POLL_MS=30000

# Public site origin for SEO (canonical URLs, Open Graph, sitemap, robots.txt)
# No trailing slash. Use your real HTTPS domain in production.
SITE_URL=https://your-domain.example.com

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Bootstrap with:  npm run db:init
# (reads MYSQL_* below; creates database + tables; optional admin user create)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ocean
MYSQL_PASSWORD=ocean_pass
MYSQL_DATABASE=ocean
# TLS / secure mode for the MySQL connection (true for remote DBs that require SSL)
# Self-signed / provider cert chains are accepted by default. To verify strictly:
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL=false
# Optional: admin/root used only by `npm run db:init` to CREATE DATABASE / USER
# Leave unset when MYSQL_USER already has those privileges (e.g. managed MySQL).
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Order confirmation email
# ---------------------------------------------------------------------------
EMAIL_TO=andrew.davis64@gmail.com

# SMTP (Gmail: smtp.gmail.com + App Password, spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional; defaults to SMTP_USER
SMTP_FROM="Ocean Market <your-address@gmail.com>"
