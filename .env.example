# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# 0.0.0.0 = accept remote connections; 127.0.0.1 = local only (use with nginx)
HOST=0.0.0.0
# Docker Compose publish bind. Production behind nginx must be 127.0.0.1.
# Local `docker compose up` can leave this unset (defaults to 0.0.0.0).
HOST_BIND=127.0.0.1
# Strong random string for session cookies (required in production)
SESSION_SECRET=replace-with-a-long-random-secret

# Admin login (session cookie — password is never in the URL)
# Set a strong password, or store only a bcrypt hash (preferred in production).
# Generate a hash: npm run admin:hash -- 'your-password'
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=

# Set when reverse-proxied (nginx/Caddy) so client IP + HTTPS work correctly
TRUST_PROXY=true
# Set when the site is served over HTTPS so session cookies are Secure
COOKIE_SECURE=true

# Public site origin for SEO (canonical URLs, Open Graph, sitemap, robots.txt)
# No trailing slash. Use your real HTTPS domain in production.
SITE_URL=https://your-domain.example.com

# ---------------------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------------------
# Bootstrap with:  npm run db:init
# (reads MYSQL_* below; creates database + tables; optional admin user create)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ocean
MYSQL_PASSWORD=ocean_pass
MYSQL_DATABASE=ocean
# TLS / secure mode for the MySQL connection (true for remote DBs that require SSL)
# Self-signed cert chains are accepted by default. To verify strictly later:
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_SSL=false
# Optional: admin/root used only by `npm run db:init` to CREATE DATABASE / USER
# Leave unset when MYSQL_USER already has those privileges (e.g. managed MySQL).
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Order confirmation email
# ---------------------------------------------------------------------------
EMAIL_TO=andrew.davis64@gmail.com

# SMTP (Gmail: smtp.gmail.com + App Password, spaces optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional; defaults to SMTP_USER
SMTP_FROM="Ocean Market <your-address@gmail.com>"
