<%- include('partials/header') %>
<%
  var adminSection = (typeof activeSection !== 'undefined' && activeSection) ? String(activeSection) : 'orders';
  var allowedAdminSections = { orders: 1, ship: 1, products: 1, 'add-product': 1, 'ip-counts': 1 };
  if (!allowedAdminSections[adminSection]) adminSection = 'orders';
  var shipQueue = (typeof shipOrders !== 'undefined' && shipOrders) ? shipOrders : [];
  var shipNotice = (typeof shipFlash !== 'undefined' && shipFlash) ? shipFlash : null;
  var shipNoticeKind = shipNotice && (shipNotice.kind === 'success' || shipNotice.kind === 'warning') ? shipNotice.kind : 'error';
  var unshippedCount = shipQueue.filter(function (order) { return order.status !== 'shipped'; }).length;
%>

  <h1 class="page-title">Admin</h1>
  <p class="page-sub">
    Manage products, pricing, stock, and orders stored in <code>local.db</code>.
  </p>

  <nav class="admin-nav" aria-label="Admin sections" data-section="<%= adminSection %>">
    <button type="button" class="admin-nav-link<%= adminSection === 'orders' ? ' is-active' : '' %>" data-section="orders" aria-current="<%= adminSection === 'orders' ? 'page' : 'false' %>">Orders</button>
    <button type="button" class="admin-nav-link<%= adminSection === 'ship' ? ' is-active' : '' %>" data-section="ship" aria-current="<%= adminSection === 'ship' ? 'page' : 'false' %>">Ship</button>
    <button type="button" class="admin-nav-link<%= adminSection === 'products' ? ' is-active' : '' %>" data-section="products" aria-current="<%= adminSection === 'products' ? 'page' : 'false' %>">Products</button>
    <button type="button" class="admin-nav-link<%= adminSection === 'add-product' ? ' is-active' : '' %>" data-section="add-product" aria-current="<%= adminSection === 'add-product' ? 'page' : 'false' %>">Add product</button>
    <button type="button" class="admin-nav-link<%= adminSection === 'ip-counts' ? ' is-active' : '' %>" data-section="ip-counts" aria-current="<%= adminSection === 'ip-counts' ? 'page' : 'false' %>">IP counts</button>
  </nav>

  <div class="admin-sections">

    <!-- Orders -->
    <section class="panel panel-wide admin-panel<%= adminSection === 'orders' ? ' is-active' : '' %>" id="orders" data-section="orders"<% if (adminSection !== 'orders') { %> hidden<% } %>>
      <h2 class="section-title">Orders (<%= orders.length %>)</h2>
      <% if (orders.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Product</th>
                <th>Email</th>
                <th>Phone</th>
                <th>IP</th>
                <th>Timestamp</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(function (order) { %>
                <tr
                  class="order-row"
                  tabindex="0"
                  role="link"
                  data-href="/admin/orders/<%= order.order_id %>"
                  title="View receipt for order <%= order.order_id_display %>"
                >
                  <td class="mono"><%= order.order_id_display %></td>
                  <td>
                    <%= order.product_name %>
                    <div class="mono" style="color:var(--ocean-mist);font-size:0.75rem;">
                      <%= order.product_id %>
                    </div>
                  </td>
                  <td><%= order.email || '—' %></td>
                  <td class="mono"><%= order.phone || '—' %></td>
                  <td class="mono"><%= order.ip_address %></td>
                  <td class="mono"><%= order.created_at %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty-state">No orders yet.</p>
      <% } %>
    </section>

    <!-- Ship -->
    <section class="panel panel-wide admin-panel<%= adminSection === 'ship' ? ' is-active' : '' %>" id="ship" data-section="ship"<% if (adminSection !== 'ship') { %> hidden<% } %>>
      <h2 class="section-title">Ship (<%= unshippedCount %> unshipped)</h2>
      <p class="ship-lead">
        Unshipped orders are listed first. Select one, click Ship, and enter a tracking number.
        Stock is reduced by the ordered quantity once. Shipping the same order again does not reduce it again.
      </p>

      <% if (shipNotice && shipNotice.message) { %>
        <div class="alert alert-<%= shipNoticeKind %>" role="alert"><%= shipNotice.message %></div>
      <% } %>

      <% if (shipQueue.length) { %>
        <form method="post" action="/admin/ship" id="ship-form">
          <%- include('partials/csrf') %>
          <div class="table-wrap ship-table-wrap">
            <table class="data ship-table">
              <thead>
                <tr>
                  <th scope="col">Select</th>
                  <th scope="col">Order</th>
                  <th scope="col">Date</th>
                  <th scope="col">Customer</th>
                  <th scope="col">Items</th>
                  <th scope="col">Total</th>
                  <th scope="col">Status</th>
                  <th scope="col">Tracking</th>
                </tr>
              </thead>
              <tbody>
                <% shipQueue.forEach(function (order) { %>
                  <tr class="ship-row<%= order.status === 'shipped' ? ' is-shipped' : '' %>">
                    <td data-label="Select">
                      <% if (order.status === 'shipped') { %>
                        <span class="ship-meta">—</span>
                      <% } else { %>
                        <label class="ship-select">
                          <input
                            type="radio"
                            name="order_id"
                            value="<%= order.order_id %>"
                            data-order-label="<%= order.order_id_display %>"
                            aria-label="Select order <%= order.order_id_display %>"
                          >
                        </label>
                      <% } %>
                    </td>
                    <td data-label="Order" class="mono">
                      <a href="/admin/orders/<%= order.order_id %>"><%= order.order_id_display %></a>
                    </td>
                    <td data-label="Date" class="mono"><%= order.created_at %></td>
                    <td data-label="Customer">
                      <% if (order.customerName) { %>
                        <div><%= order.customerName %></div>
                      <% } %>
                      <% if (order.email) { %>
                        <div class="<%= order.customerName ? 'ship-meta' : '' %>"><%= order.email %></div>
                      <% } else if (!order.customerName) { %>
                        <div>—</div>
                      <% } %>
                      <% if (order.phone) { %>
                        <div class="ship-meta mono"><%= order.phone %></div>
                      <% } %>
                    </td>
                    <td data-label="Items">
                      <% if (order.lineItems && order.lineItems.length) { %>
                        <ul class="ship-items">
                          <% order.lineItems.forEach(function (item) { %>
                            <li><%= item.name %> × <%= item.quantity %></li>
                          <% }) %>
                        </ul>
                      <% } else { %>
                        <%= order.product_name || '—' %>
                      <% } %>
                    </td>
                    <td data-label="Total">
                      <% if (order.hasPrices) { %>
                        $<%= formatPrice(order.subtotal) %>
                      <% } else { %>
                        <span title="Price unavailable because a product is no longer in the catalog">—</span>
                      <% } %>
                    </td>
                    <td data-label="Status">
                      <% if (order.status === 'shipped') { %>
                        <span class="status-badge status-shipped">Shipped</span>
                      <% } else { %>
                        <span class="status-badge status-unshipped">Unshipped</span>
                      <% } %>
                    </td>
                    <td data-label="Tracking">
                      <% if (order.tracking_number) { %>
                        <div class="tracking-number"><%= order.tracking_number %></div>
                        <% if (order.carrier || order.shipped_at) { %>
                          <div class="ship-meta">
                            <% if (order.carrier) { %><%= order.carrier %><% } %><% if (order.carrier && order.shipped_at) { %> · <% } %><% if (order.shipped_at) { %><%= order.shipped_at %><% } %>
                          </div>
                        <% } %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="ship-actions">
            <button
              type="button"
              class="btn btn-primary"
              id="ship-start"
              <% if (!unshippedCount) { %>disabled<% } %>
            >Ship</button>
            <p id="ship-hint" class="ship-hint" role="status"></p>
          </div>

          <dialog id="ship-dialog" class="ship-dialog" aria-labelledby="ship-dialog-title">
            <h3 id="ship-dialog-title">Ship order <span id="ship-dialog-order"></span></h3>
            <p class="ship-lead">
              Tracking number is required. Carrier is optional.
              Confirming reduces stock for this order a single time.
            </p>
            <div class="form-group">
              <label for="tracking_number">Tracking number</label>
              <input
                type="text"
                id="tracking_number"
                name="tracking_number"
                maxlength="128"
                autocomplete="off"
                placeholder="1Z999…"
              >
            </div>
            <div class="form-group">
              <label for="carrier">
                Carrier
                <span style="font-weight:400;color:var(--ocean-mist)">(optional)</span>
              </label>
              <input
                type="text"
                id="carrier"
                name="carrier"
                maxlength="64"
                autocomplete="off"
                placeholder="UPS, USPS, FedEx"
              >
            </div>
            <div class="actions">
              <button type="submit" class="btn btn-primary">Ship order</button>
              <button type="button" class="btn btn-secondary" id="ship-cancel">Cancel</button>
            </div>
          </dialog>
        </form>
      <% } else { %>
        <p class="empty-state">No orders to ship yet.</p>
      <% } %>
    </section>

    <!-- Products -->
    <section class="panel panel-wide admin-panel<%= adminSection === 'products' ? ' is-active' : '' %>" id="products" data-section="products"<% if (adminSection !== 'products') { %> hidden<% } %>>
      <h2 class="section-title">Products (<%= products.length %>)</h2>
      <p style="margin:0 0 1rem;color:var(--ocean-mist);font-size:0.9rem;">
        Update price and quantity available, or upload a new photo.
      </p>

      <% if (products.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>Photo</th>
                <th>Product</th>
                <th>Price &amp; qty</th>
                <th>Upload photo</th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function (product) { %>
                <tr>
                  <td>
                    <img
                      class="admin-thumb"
                      src="<%= product.image %>"
                      alt="<%= product.name %>"
                      width="64"
                      height="32"
                    >
                  </td>
                  <td>
                    <strong><%= product.name %></strong>
                    <div class="mono" style="color:var(--ocean-mist);font-size:0.75rem;">
                      <%= product.id %>
                    </div>
                    <div style="color:var(--ocean-mist);font-size:0.85rem;margin-top:0.25rem;">
                      <%= product.description %>
                    </div>
                  </td>
                  <td>
                    <form
                      method="post"
                      action="/admin/products/<%= product.id %>/update"
                      class="admin-pricing-form"
                    >
                      <%- include('partials/csrf') %>
                      <label class="admin-field-label">
                        Price
                        <input
                          type="number"
                          name="price"
                          min="0"
                          step="0.01"
                          value="<%= formatPrice(product.price) %>"
                          required
                          class="admin-inline-input"
                        >
                      </label>
                      <label class="admin-field-label">
                        Qty available
                        <input
                          type="number"
                          name="qty_available"
                          min="0"
                          step="1"
                          value="<%= product.qtyAvailable %>"
                          required
                          class="admin-inline-input"
                        >
                      </label>
                      <button type="submit" class="btn btn-primary btn-sm">Save</button>
                    </form>
                  </td>
                  <td>
                    <form
                      method="post"
                      action="/admin/products/<%= product.id %>/photo"
                      enctype="multipart/form-data"
                      class="admin-photo-form"
                    >
                      <%- include('partials/csrf') %>
                      <input type="file" name="photo" accept="image/jpeg,image/png,image/gif,image/webp" required>
                      <button type="submit" class="btn btn-secondary btn-sm">Upload</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty-state">No products yet. Add one below.</p>
      <% } %>
    </section>

    <!-- Add product -->
    <section class="panel panel-wide admin-panel<%= adminSection === 'add-product' ? ' is-active' : '' %>" id="add-product" data-section="add-product"<% if (adminSection !== 'add-product') { %> hidden<% } %>>
      <h2 class="section-title">Add new product</h2>
      <form
        method="post"
        action="/admin/products"
        enctype="multipart/form-data"
        class="admin-add-form"
      >
        <%- include('partials/csrf') %>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" required placeholder="Sea Glass Necklace">
          </div>
          <div class="form-group">
            <label for="price">Price (USD)</label>
            <input type="number" id="price" name="price" min="0" step="0.01" required placeholder="19.99">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="qty_available">Qty available</label>
            <input type="number" id="qty_available" name="qty_available" min="0" step="1" value="25" required>
          </div>
          <div class="form-group">
            <label for="id">
              Product ID
              <span style="font-weight:400;color:var(--ocean-mist)">(optional)</span>
            </label>
            <input type="text" id="id" name="id" placeholder="sea-glass-necklace" pattern="[a-z0-9\-]*">
            <span class="hint">Auto-built from name if left blank.</span>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="3" placeholder="Short product description"></textarea>
        </div>

        <div class="form-group">
          <label for="photo">
            Photo
            <span style="font-weight:400;color:var(--ocean-mist)">(optional)</span>
          </label>
          <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/gif,image/webp">
          <span class="hint">JPEG, PNG, GIF, or WebP — max 5&nbsp;MB. A placeholder is used if omitted.</span>
        </div>

        <button type="submit" class="btn btn-primary">Add product</button>
      </form>
    </section>

    <!-- IP counts -->
    <section class="panel panel-wide admin-panel<%= adminSection === 'ip-counts' ? ' is-active' : '' %>" id="ip-counts" data-section="ip-counts"<% if (adminSection !== 'ip-counts') { %> hidden<% } %>>
      <div class="section-heading-row">
        <h2 class="section-title">IP order counts</h2>
        <% if (ipCounts.length) { %>
          <form method="post" action="/admin/ip-counts/reset">
            <%- include('partials/csrf') %>
            <input type="hidden" name="ip_address" value="all">
            <button type="submit" class="btn btn-secondary btn-sm">Reset all counters</button>
          </form>
        <% } %>
      </div>
      <p style="margin:0 0 0.5rem;color:var(--ocean-mist);font-size:0.9rem;">
        Separate table used to enforce the per-IP limit (<%= maxOrdersPerIp %> max).
        Reset clears the counter only — it does not delete orders.
      </p>
      <% if (ipCounts.length) { %>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr>
                <th>IP address</th>
                <th>Orders placed</th>
                <th>Remaining</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% ipCounts.forEach(function (row) { %>
                <tr>
                  <td class="mono"><%= row.ip_address %></td>
                  <td><%= row.order_count %></td>
                  <td><%= Math.max(0, maxOrdersPerIp - row.order_count) %></td>
                  <td>
                    <form method="post" action="/admin/ip-counts/reset">
                      <%- include('partials/csrf') %>
                      <input type="hidden" name="ip_address" value="<%= row.ip_address %>">
                      <button type="submit" class="btn btn-secondary btn-sm">Reset</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty-state">No IP activity yet.</p>
      <% } %>
    </section>
  </div>

  <p style="margin-top:1.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
    <a class="btn btn-secondary" href="/">Back to shop</a>
    <form method="post" action="/admin/logout">
      <%- include('partials/csrf') %>
      <button type="submit" class="btn btn-secondary">Log out</button>
    </form>
  </p>

  <script src="/js/admin.js" defer></script>

<%- include('partials/footer') %>
