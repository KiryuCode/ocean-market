<%- include('partials/header') %>

  <h1 class="page-title">Inventory</h1>

  <div class="product-grid">
    <% products.forEach(function (product) { %>
      <article class="product-card">
        <img
          class="product-image"
          src="<%= product.image %>"
          alt="<%= product.name %>"
          loading="lazy"
          width="600"
          height="188"
        >
        <div class="product-body">
          <h2 class="product-name"><%= product.name %></h2>
          <p class="product-desc"><%= product.description %></p>
          <p class="product-stock<%= product.qtyAvailable < 1 ? ' product-stock-out' : '' %>">
            <%= product.qtyAvailable < 1 ? 'Out of stock' : product.qtyAvailable + ' available' %>
          </p>
          <div class="product-footer">
            <span class="price">$<%= formatPrice(product.price) %></span>
            <div class="product-actions">
              <% if (product.qtyAvailable > 0) { %>
                <form method="post" action="/cart/add" class="inline-form js-add-to-cart">
                  <%- include('partials/csrf') %>
                  <input type="hidden" name="product_id" value="<%= product.id %>">
                  <input type="hidden" name="redirect" value="shop">
                  <button type="submit" class="btn btn-secondary btn-sm">Add to Cart</button>
                </form>
                <a class="btn btn-primary btn-sm" href="/buy/<%= product.id %>">Buy Now</a>
              <% } else { %>
                <span class="btn btn-secondary btn-sm" style="opacity:0.55;cursor:not-allowed;">Unavailable</span>
              <% } %>
            </div>
          </div>
        </div>
      </article>
    <% }) %>
  </div>

<%- include('partials/footer') %>
